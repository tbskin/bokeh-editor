# Your API's reachable address. On a physical phone, use the computer's LAN IP or HTTPS domain.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Optional alternative used by the development Settings selector.
EXPO_PUBLIC_LOCAL_API_URL=
# Use your own Supabase project and public client key. Never put a secret/service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional analytics; disabled when blank.
EXPO_PUBLIC_POSTHOG_KEY=
