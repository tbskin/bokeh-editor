# Copy to .env. Supply your own accounts; never commit actual values.
# OpenAI: vision, scripts, and structured edit planning.
OPENAI_API_KEY=
# ElevenLabs: transcription and optional cloned narration.
ELEVENLABS_API_KEY=
# Your Supabase project's URL, server-only secret key, and Postgres connection string.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Optional legacy alternative to SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct storage hostname override; normally derived from SUPABASE_URL.
SUPABASE_STORAGE_TUS_URL=
# Omit OLE_DATA to use the API default. Containers set it to a persistent /data mount.
# OLE_DATA=/absolute/path/to/bokeh-data
PORT=8787
OLE_HYPERFRAMES=1
# Experimental: enable only after testing your own repeated-take footage.
OLE_TALKING_HEAD=0
# Optional editor model override; defaults to gpt-5.5.
# OLE_EDITOR_MODEL=gpt-5.5
# Optional analytics. Blank means disabled.
POSTHOG_API_KEY=
POSTHOG_HOST=
